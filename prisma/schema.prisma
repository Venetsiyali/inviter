// ============================================================
// inviter.uz — Database Schema
// PostgreSQL + Prisma ORM
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── USER ─────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  googleId      String?   @unique

  // Subscription
  plan          String    @default("FREE") // FREE | PRO
  planExpiry    DateTime?

  // Admin
  role          String    @default("USER") // USER | ADMIN

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      AuthSession[]
  invitations   Invitation[]
  payments      Payment[]

  @@index([email])
}

// ─── NEXTAUTH MODELS ──────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── INVITATION (Core Business Model) ─────────────────────────
model Invitation {
  id              String   @id @default(cuid())
  slug            String   @unique @default(cuid())
  userId          String

  // Event info
  eventType       String   // WEDDING, OSH, BIRTHDAY, ENGAGEMENT, SUNNAT, OTHER
  brideGroom      String   // "Alisher & Madina" or event title
  eventDate       DateTime
  eventTime       String?  // "18:00"
  venue           String?  // "Navruz" restaurant name
  venueAddress    String?  // Full address text
  venueLat        Float?
  venueLng        Float?
  phone           String?  // Contact phone

  // Design
  templateId      String   // e.g. "wedding-classic"
  primaryColor    String   @default("#1E3A5F")
  secondaryColor  String   @default("#C9A96E")
  coverImageUrl   String?  // Custom cover image (R2)
  htmlContent     String?  @db.Text // Pre-rendered HTML

  // QR Code
  qrCodeUrl       String?  // Generated QR image URL

  // Features
  giftEnabled     Boolean  @default(false)
  giftClickId     String?  // Click merchant service ID for gifts
  photoEnabled    Boolean  @default(false)

  // Publishing
  isPublished     Boolean  @default(false)
  viewCount       Int      @default(0)
  qrScanCount     Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifts           Gift[]
  photos          Photo[]

  @@index([userId])
  @@index([slug])
  @@index([eventType])
}

// ─── GIFT (Donations from guests) ─────────────────────────────
model Gift {
  id              String   @id @default(cuid())
  invitationId    String

  guestName       String
  guestPhone      String?
  message         String?  @db.Text

  amount          Int      // Amount in UZS (tiyin)
  currency        String   @default("UZS")
  status          String   @default("PENDING") // PENDING | COMPLETED | FAILED | REFUNDED
  provider        String?  // "click" | "payme"
  transactionId   String?  // External payment transaction ID

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([status])
}

// ─── PHOTO (Guest-uploaded photos) ────────────────────────────
model Photo {
  id              String   @id @default(cuid())
  invitationId    String

  uploaderName    String
  url             String   // Full-size image URL (R2)
  thumbnailUrl    String?  // Thumbnail URL (R2)
  fileSize        Int?     // Bytes
  approved        Boolean  @default(true)

  createdAt       DateTime @default(now())

  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

// ─── PAYMENT (PRO subscription purchases) ─────────────────────
model Payment {
  id              String   @id @default(cuid())
  userId          String

  amount          Int      // Amount in UZS (tiyin)
  currency        String   @default("UZS")
  status          String   @default("PENDING") // PENDING | COMPLETED | FAILED | REFUNDED
  provider        String   // "click" | "payme"
  transactionId   String?  // External payment ID
  description     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
